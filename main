
# main.py (Phase 0, 10, 11)
import flwr as fl
from server.SecureServer import SecureServer
from client.SecureClient import SecureClient
import torch
import torchvision.transforms as transforms
import torchvision.datasets as datasets
from model.Net import Net

# Phase 0 - Initialization
def load_data():
    transform = transforms.Compose([transforms.ToTensor()])
    trainset = datasets.CIFAR10(root="./data", train=True, download=True, transform=transform)
    testset = datasets.CIFAR10(root="./data", train=False, download=True, transform=transform)
    return trainset, testset

trainset, testset = load_data()

# Client creation function
def client_fn(cid):
    client = SecureClient(cid, trainset)
    client.model = Net()
    return client

# Server strategy
strategy = SecureServer(model=Net())

# Phase 10 - Start FL simulation
fl.simulation.start_simulation(
    client_fn=client_fn,
    num_clients=5,
    config=fl.server.ServerConfig(num_rounds=3),
    strategy=strategy,
)

# Phase 11 - Logging placeholder
print("[INFO] Simulation complete. Logs can be extended here.")
